# Prisma database connection string.
DATABASE_URL="postgresql://msag_local:change-me@localhost:5432/my_south_african_guide?schema=public"

# Local Docker PostgreSQL settings. Keep these values local and replace them
# with deployment environment variables in Coolify.
POSTGRES_DB="my_south_african_guide"
POSTGRES_USER="msag_local"
POSTGRES_PASSWORD="change-me"

# Optional public-site configuration.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# At least 32 random characters. Keep this server-only and configure it in Coolify later.
AUTH_SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Development-only controlled admin bootstrap secret. Do not expose publicly.
ADMIN_BOOTSTRAP_SECRET=""