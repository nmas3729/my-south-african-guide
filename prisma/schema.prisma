generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRAVELLER
  GUIDE
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum VerificationStatus {
  DRAFT
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationDocumentType {
  IDENTITY_DOCUMENT
  GUIDE_REGISTRATION
  PERMIT
  CERTIFICATE
  OTHER
}

enum VerificationDocumentStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ExperienceStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  REJECTED
  HIDDEN
}

enum DestinationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum CommissionStatus {
  PENDING
  EARNED
  SETTLED
  VOIDED
}

/// Lifecycle of a concrete bookable departure (a generated/hand-authored session).
enum TourSlotStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// State of a capacity commitment against a TourSlot. Holds carry an expiry.
enum SlotReservationStatus {
  HELD
  PENDING_PAYMENT
  COMMITTED
  CONFIRMED
  RELEASED
  EXPIRED
  CANCELLED
}

/// Date/period-specific override layered on top of an AvailabilityRule.
enum AvailabilityExceptionType {
  BLOCKED
  SPECIAL_DEPARTURE
  CAPACITY_OVERRIDE
}

/// Immutable audit event describing something that happened to a booking.
enum BookingEventType {
  BOOKING_CREATED
  STATUS_CHANGED
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  RESERVATION_HELD
  RESERVATION_CONFIRMED
  RESERVATION_RELEASED
  RESERVATION_EXPIRED
  RESERVATION_CANCELLED
  CANCELLED
  REFUNDED
  NOTE
}

/// Lifecycle of a financial invoice. Tax treatment is intentionally undecided.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model User {
  id                String            @id @default(cuid())
  name              String?
  firstName         String?
  lastName          String?
  email             String            @unique
  passwordHash      String?
  phone             String?
  role              UserRole          @default(TRAVELLER)
  status            UserStatus        @default(ACTIVE)
  emailVerifiedAt   DateTime?
  sessionVersion    Int               @default(0)
  profileImage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  travellerProfile  TravellerProfile?
  guideProfile      GuideProfile?
  travellerBookings Booking[]         @relation("TravellerBookings")
  reviews           Review[]          @relation("TravellerReviews")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  bookingEvents     BookingEvent[]    @relation("BookingEventActor")
  invoices          Invoice[]         @relation("CustomerInvoices")

  @@index([role, status])
  @@index([emailVerifiedAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model TravellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  country     String?
  phone       String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuideProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  slug                  String?                @unique
  displayName           String?
  bio                   String?
  location              String?
  timezone              String?                @db.VarChar(64)
  languages             String[]
  provinces             String[]
  qualifications        String[]
  profileImage          String?
  verified              Boolean                @default(false)
  verificationStatus    VerificationStatus     @default(DRAFT)
  verificationDate      DateTime?
  rejectionReason       String?
  active                Boolean                @default(true)
  rating                Decimal                @default(0) @db.Decimal(3, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences           Experience[]
  eligibleExperiences   ExperienceGuide[]
  verificationDocuments VerificationDocument[]
  bookings              Booking[]              @relation("GuideBookings")
  reviews               Review[]               @relation("GuideReviews")
  slots                 TourSlot[]             @relation("GuideSlots")
  scheduleRules         GuideScheduleRule[]
  unavailability        GuideUnavailability[]

  @@index([verificationStatus])
  @@index([verified])
  @@index([active, verificationStatus])
}

model VerificationDocument {
  id           String                     @id @default(cuid())
  guideId      String
  documentType VerificationDocumentType
  storageReference String
  status       VerificationDocumentStatus @default(SUBMITTED)
  submittedAt  DateTime                   @default(now())
  reviewedAt   DateTime?
  rejectionReason String?
  guide        GuideProfile               @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, status])
}

model Destination {
  id          String       @id @default(cuid())
  name        String
  province    String
  description String?
  image       String?
  slug        String       @unique
  status      DestinationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  experiences Experience[]

  @@index([province])
  @@index([status, province])
}

model Experience {
  id            String            @id @default(cuid())
  guideId       String
  destinationId String
  title         String
  slug          String            @unique
  summary       String?
  description   String
  category      String?
  duration      Int // Duration in minutes.
  location      String?
  meetingPoint  String?
  groupLimit    Int?
  timezone      String?           @db.VarChar(64)
  languages     String[]          @default([])
  pricingModel  String?
  price         Int // Price in minor currency units, e.g. cents.
  currency      String            @default("ZAR") @db.VarChar(3)
  status        ExperienceStatus  @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  publishedAt   DateTime?
  guide         GuideProfile      @relation(fields: [guideId], references: [id], onDelete: Restrict)
  destination   Destination       @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  images        ExperienceImage[]
  eligibleGuides ExperienceGuide[]
  bookings      Booking[]
  reviews       Review[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  slots                  TourSlot[]

  @@index([guideId, status])
  @@index([destinationId, status])
  @@index([status])
}

model ExperienceGuide {
  experienceId String
  guideId      String
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  experience   Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  guide        GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([experienceId, guideId])
  @@index([guideId, experienceId])
}

model ExperienceImage {
  id           String     @id @default(cuid())
  experienceId String
  url          String
  altText      String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, order])
  @@index([experienceId])
}

model Booking {
  id             String        @id @default(cuid())
  travellerId    String
  experienceId   String
  guideId        String
  bookingDate    DateTime
  numberOfGuests Int
  travellerMessage String?
  status         BookingStatus @default(REQUESTED)
  totalAmount    Int // Total in minor currency units.
  currency       String        @default("ZAR") @db.VarChar(3)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  acceptedAt     DateTime?
  declinedAt     DateTime?
  confirmedAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  confirmationReference String? @unique
  slotId         String?
  startsAt       DateTime?     @db.Timestamptz(3)
  endsAt         DateTime?     @db.Timestamptz(3)
  timezone       String?       @db.VarChar(64)
  reservationIdempotencyKey String? @db.VarChar(128)
  reservationRequestHash    String? @db.VarChar(64)
  privateGuide   Boolean?
  unitPriceAmount Int?
  subtotalAmount Int?
  guideFeeAmount Int?
  extrasAmount   Int?
  discountAmount Int?
  vatRateBps     Int?
  vatAmount      Int?
  traveller      User          @relation("TravellerBookings", fields: [travellerId], references: [id], onDelete: Restrict)
  experience     Experience    @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  guide          GuideProfile  @relation("GuideBookings", fields: [guideId], references: [id], onDelete: Restrict)
  slot           TourSlot?     @relation(fields: [slotId], references: [id], onDelete: Restrict)
  slotReservation SlotReservation?
  events         BookingEvent[]
  invoice        Invoice?
  payments       Payment[]
  commission     Commission?
  review         Review?

  @@index([travellerId, status])
  @@index([guideId, status])
  @@index([experienceId, bookingDate])
  @@index([status, bookingDate])
  @@index([slotId])
  @@unique([travellerId, reservationIdempotencyKey])
}

model Review {
  id           String       @id @default(cuid())
  bookingId    String       @unique
  travellerId  String
  guideId      String
  experienceId String
  rating       Int
  comment      String
  status       ReviewStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  publishedAt  DateTime?
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveller    User         @relation("TravellerReviews", fields: [travellerId], references: [id], onDelete: Restrict)
  guide        GuideProfile @relation("GuideReviews", fields: [guideId], references: [id], onDelete: Restrict)
  experience   Experience   @relation(fields: [experienceId], references: [id], onDelete: Restrict)

  @@index([guideId, createdAt])
  @@index([experienceId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  amount            Int // Amount in minor currency units.
  currency          String        @default("ZAR") @db.VarChar(3)
  provider          String
  transactionId     String?       @unique
  providerPaymentId String?
  idempotencyKey    String?       @unique
  status            PaymentStatus @default(PENDING)
  failureCode       String?
  failureMessage    String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  paidAt            DateTime?     @db.Timestamptz(3)
  failedAt          DateTime?     @db.Timestamptz(3)
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]

  @@index([bookingId])
  @@index([provider, transactionId])
  @@index([status, createdAt])
}

model Commission {
  id         String           @id @default(cuid())
  bookingId  String           @unique
  percentage Decimal          @db.Decimal(5, 2)
  amount     Int // Commission in minor currency units.
  status     CommissionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

/// Recurring weekly availability template. dayOfWeek follows JS/PostgreSQL getDay(): 0 = Sunday .. 6 = Saturday.
/// endTimeLocal defines the same-day range; durationMinutes remains only for compatibility.
model AvailabilityRule {
  id               String    @id @default(cuid())
  experienceId     String
  dayOfWeek        Int
  startTimeLocal   String    @db.VarChar(5)
  endTimeLocal     String    @db.VarChar(5)
  durationMinutes  Int?
  capacityOverride Int?
  seasonStartDate  DateTime? @db.Date
  seasonEndDate    DateTime? @db.Date
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  experience       Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, active])
  @@index([experienceId, dayOfWeek])
}

/// Date/period-specific override applied on top of AvailabilityRule when generating or adjusting slots.
model AvailabilityException {
  id               String                    @id @default(cuid())
  experienceId     String
  type             AvailabilityExceptionType
  date             DateTime?                 @db.Date
  startsAt         DateTime?                 @db.Timestamptz(3)
  endsAt           DateTime?                 @db.Timestamptz(3)
  capacityOverride Int?
  reason           String?
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  experience       Experience                @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, date])
  @@index([experienceId, startsAt, endsAt])
}


/// A concrete departure. Stored instants are UTC (timestamptz); timezone is its IANA display zone.
/// Reservation status and expiry are authoritative for capacity; seat counters are transactional mirrors.
model TourSlot {
  id             String            @id @default(cuid())
  experienceId   String
  guideId        String
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  timezone       String            @db.VarChar(64)
  capacity       Int
  privateBookingEnabled Boolean    @default(false)
  committedSeats Int               @default(0)
  heldSeats      Int               @default(0)
  status         TourSlotStatus    @default(OPEN)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  experience     Experience        @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  guide          GuideProfile      @relation("GuideSlots", fields: [guideId], references: [id], onDelete: Restrict)
  reservations   SlotReservation[]
  bookings       Booking[]

  @@unique([experienceId, startsAt])
  @@index([experienceId, status, startsAt])
  @@index([guideId, startsAt])
  @@index([status, startsAt])
}

/// A capacity commitment against a slot (hold or committed booking seats). bookingId is unique once a booking exists.
model SlotReservation {
  id         String                @id @default(cuid())
  slotId     String
  bookingId  String                @unique
  partySize  Int
  status     SlotReservationStatus @default(HELD)
  expiresAt  DateTime?             @default(dbgenerated("(CURRENT_TIMESTAMP + '00:30:00'::interval)")) @db.Timestamptz(3)
  releasedAt DateTime?             @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  slot       TourSlot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  booking    Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events     BookingEvent[]

  @@index([slotId, status, expiresAt])
  @@index([status, expiresAt])
}

/// Recurring weekly working hours for a guide. dayOfWeek uses the same 0 = Sunday convention.
model GuideScheduleRule {
  id             String       @id @default(cuid())
  guideId        String
  dayOfWeek      Int
  startTimeLocal String       @db.VarChar(5)
  endTimeLocal   String       @db.VarChar(5)
  effectiveFrom  DateTime?    @db.Date
  effectiveTo    DateTime?    @db.Date
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  guide          GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, active])
  @@index([guideId, dayOfWeek])
}

/// Guide-specific exception window (leave, blocked period, personal unavailability). Instants are UTC.
model GuideUnavailability {
  id        String       @id @default(cuid())
  guideId   String
  startsAt  DateTime     @db.Timestamptz(3)
  endsAt    DateTime     @db.Timestamptz(3)
  allDay    Boolean      @default(false)
  reason    String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  guide     GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, startsAt, endsAt])
}


/// Immutable audit trail of booking lifecycle events. Application event emission is a later phase.
model BookingEvent {
  id               String           @id @default(cuid())
  bookingId        String
  reservationId    String?
  type             BookingEventType
  fromStatus       BookingStatus?
  toStatus         BookingStatus?
  actorId          String?
  actorRole        UserRole?
  paymentReference String?
  metadata         Json?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reservation      SlotReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actor            User?            @relation("BookingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([reservationId, createdAt])
  @@index([type])
  @@index([actorId])
}

/// Raw/processed payment provider notification used for idempotent, replay-safe webhook handling.
model PaymentEvent {
  id                String   @id @default(cuid())
  paymentId         String?
  provider          String
  providerEventId   String
  eventType         String?
  payload           Json?
  signatureVerified Boolean  @default(false)
  processedAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([createdAt])
}

/// Immutable financial snapshot for a booking. VAT treatment and legal issuer details are intentionally undecided.
model Invoice {
  id                     String        @id @default(cuid())
  invoiceNumber          String        @unique
  bookingId              String        @unique
  customerUserId         String?
  customerName           String?
  customerEmail          String?
  customerBillingAddress Json?
  customerVatNumber      String?
  experienceTitle        String?
  experienceStartsAt     DateTime?     @db.Timestamptz(3)
  guideName              String?
  subtotalAmount         Int
  guideFeeAmount         Int           @default(0)
  extrasAmount           Int           @default(0)
  discountAmount         Int           @default(0)
  vatRateBps             Int?
  vatAmount              Int           @default(0)
  totalAmount            Int
  currency               String        @default("ZAR") @db.VarChar(3)
  paymentReference       String?
  status                 InvoiceStatus @default(DRAFT)
  issuedAt               DateTime?     @db.Timestamptz(3)
  dueAt                  DateTime?     @db.Timestamptz(3)
  pdfStorageRef          String?
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  booking                Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer               User?         @relation("CustomerInvoices", fields: [customerUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([customerUserId])
}

